{
  "name": "pencil-voice",
  "version": "0.1.1",
  "description": "A synthesized pencil-on-paper sound that follows any SVG stroke as it is drawn: speed, direction, curvature, sharp turns and position on screen.",
  "license": "MIT",
  "author": "Tanish Misra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishmisra9/pencil-voice.git"
  },
  "homepage": "https://tanishmisra9.github.io/pencil-voice/examples/",
  "keywords": [
    "web-audio",
    "audioworklet",
    "sound",
    "synthesis",
    "pencil",
    "drawing",
    "svg",
    "scroll",
    "animation",
    "sfx"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./inline": {
      "types": "./dist/inline.d.ts",
      "default": "./dist/inline.js"
    },
    "./pencil-processor.js": "./dist/pencil-processor.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "test:browser": "node tools/browser-test.mjs",
    "fit": "node tools/fit.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "typescript": "^5.9.3"
  }
}
